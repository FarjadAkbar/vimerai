# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123
DB_NAME=vimerai

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-secret-key-change-in-production

# ============================================
# Payment Configuration
# ============================================
# Provider: paypal | stripe
PAYMENT_PROVIDER=paypal

# PayPal Credentials
# Use Sandbox Client ID and Secret for integration and testing.
# Live credentials only after testing is complete and before going live.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_SECRET=your-paypal-sandbox-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Single-shot one-time purchase amount (EUR). Pricing is managed on PayPal.
SINGLE_SHOT_AMOUNT=10

# Fallback pricing region when geo headers are missing (e.g. local dev).
# With Vercel (x-vercel-ip-country) or Cloudflare (cf-ipcountry), region is derived from user location: MEA → mea, else global.
PRICING_REGION=global

# Stripe (when PAYMENT_PROVIDER=stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_STARTER=price_...
# STRIPE_PRICE_ID_CREATOR=price_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_LIVE_PRICE_ID_STARTER=price_...
# STRIPE_LIVE_PRICE_ID_CREATOR=price_...
# STRIPE_LIVE_PRICE_ID_PRO=price_...

# ============================================
# Video Generation (fal.ai default)
# ============================================
VIDEO_GENERATION_PROVIDER=fal
FAL_KEY=YOUR_FAL_KEY
FAL_BASE_URL=https://queue.fal.run/fal-ai/
FAL_MODEL=pika/v2.2/text-to-video
# FAL_TIMEOUT=300000
# Legacy full URL (optional fallback if FAL_BASE_URL / FAL_MODEL unset):
# FAL_API_URL=https://queue.fal.run/fal-ai/pika/v2.2/text-to-video

# ============================================
# Text Generation (OpenAI)
# ============================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1

# ============================================
# Product kit (single ecommerce SKU)
# ============================================
ACTIVE_KIT_ID=nitro-shine
# Path to kit/ folder (relative to backend cwd or absolute)
KIT_ROOT_DIR=../kit

# ============================================
# Email Configuration (Gmail)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=ax@gmail.com
EMAIL_PASSWORD=abc
EMAIL_FROM=ax@gmail.com
