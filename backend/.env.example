# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123
DB_NAME=vimerai

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-secret-key-change-in-production

# ============================================
# Payment Configuration
# ============================================
# Provider: paypal | stripe
PAYMENT_PROVIDER=paypal

# PayPal Credentials
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# ─── Plan IDs (used by: pnpm seed:plans) ─────────────────────────────
# These populate the plans DB table. After seeding, the DB is the source of truth.
# Switch sandbox <-> live at runtime by changing PAYPAL_ENVIRONMENT above.

# PayPal Sandbox Plan IDs
PAYPAL_PLAN_ID_STARTER_MONTHLY=P-xxx
PAYPAL_PLAN_ID_STARTER_YEARLY=P-xxx
PAYPAL_PLAN_ID_CREATOR_MONTHLY=P-xxx
PAYPAL_PLAN_ID_CREATOR_YEARLY=P-xxx
PAYPAL_PLAN_ID_PRO_MONTHLY=P-xxx
PAYPAL_PLAN_ID_PRO_YEARLY=P-xxx

# PayPal Live Plan IDs (fill before going live)
# PAYPAL_LIVE_PLAN_ID_STARTER_MONTHLY=P-xxx
# PAYPAL_LIVE_PLAN_ID_STARTER_YEARLY=P-xxx
# PAYPAL_LIVE_PLAN_ID_CREATOR_MONTHLY=P-xxx
# PAYPAL_LIVE_PLAN_ID_CREATOR_YEARLY=P-xxx
# PAYPAL_LIVE_PLAN_ID_PRO_MONTHLY=P-xxx
# PAYPAL_LIVE_PLAN_ID_PRO_YEARLY=P-xxx

# Stripe (when PAYMENT_PROVIDER=stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_STARTER=price_...
# STRIPE_PRICE_ID_CREATOR=price_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_LIVE_PRICE_ID_STARTER=price_...
# STRIPE_LIVE_PRICE_ID_CREATOR=price_...
# STRIPE_LIVE_PRICE_ID_PRO=price_...

# ============================================
# Email Configuration (Gmail)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=ax@gmail.com
EMAIL_PASSWORD=abc
EMAIL_FROM=ax@gmail.com
